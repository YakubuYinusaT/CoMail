# Copy to .env for local work. Never commit the real file.

# Neon pooled connection string, project Cohandle (curly-snow-63610598).
# Take it from the Neon console or `neon connection-string`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/cohandle?sslmode=require

# Renderer service URL. Empty locally means JS-heavy pages are skipped
# and flagged rather than rendered.
RENDER_SERVICE_URL=

# LLM provider. Switch vendors here; nothing else changes.
LLM_PROVIDER=anthropic
# LLM_MODEL=              # optional override, e.g. gpt-4o or claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Zoho Mail, see the build spec
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=

# Shared secret the poller job presents when calling the API
INTERNAL_TOKEN=

# Shared password for the review queue. Empty means no login at all,
# which is right locally and right behind Identity-Aware Proxy, and
# wrong on a public Cloud Run URL. Set it with scripts/setkey.py.
APP_PASSWORD=
# Optional. Empty derives the cookie signing key from the password.
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=14

# Arming switch for sending. Everything works with this false except
# the API call itself, which is recorded instead of made.
SEND_ENABLED=false

# What approving a draft does: "draft" writes it into your Zoho Drafts
# folder for you to send; "send" delivers it directly.
DELIVERY_MODE=draft

# Carry the designed HTML signature. false uses the plain text one.
HTML_EMAIL=true
