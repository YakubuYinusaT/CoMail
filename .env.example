# Copy to .env for local work. Never commit the real file.

# Neon pooled connection string, project Cohandle (curly-snow-63610598).
# Take it from the Neon console or `neon connection-string`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/cohandle?sslmode=require

# Renderer service URL. Empty locally means JS-heavy pages are skipped
# and flagged rather than rendered.
RENDER_SERVICE_URL=

# LLM provider
ANTHROPIC_API_KEY=

# Zoho Mail, see the build spec
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=

# Shared secret the poller job presents when calling the API
INTERNAL_TOKEN=
